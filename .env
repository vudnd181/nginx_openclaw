# ============================================================
# Nginx Reverse Proxy Settings
# This is the single source of truth for domain configuration.
# All scripts (generate-compose.sh, deploy-bot.sh, etc.) read from here.
# ============================================================

# Your domain — bots will be accessible at: botname.DOMAIN
# Example: DOMAIN=dashboard.mysite.com → vu.dashboard.mysite.com
DOMAIN=dashboard.example.com

# Email for Let's Encrypt certificate notifications
CERTBOT_EMAIL=admin@example.com
